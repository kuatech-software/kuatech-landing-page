# Copiá este archivo como .env.local y completá los valores. NUNCA pongas claves reales acá:
# este archivo se sube al repo (que es público).

# Resend (https://resend.com) — envío de mails del formulario
RESEND_API_KEY=
# Casilla que recibe los mensajes del formulario
CONTACT_TO_EMAIL=
# Remitente. Sin dominio verificado en Resend usar: Kuatech Web <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Kuatech Web <onboarding@resend.dev>

# Cloudflare Turnstile (antispam). Sin estas claves, en desarrollo el form funciona igual.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
